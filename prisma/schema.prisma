// Vulnerability Management System - Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Master (normalized, deduplicated) ───────────────────────

model Vulnerability {
  id          String   @id @default(cuid())

  // Deduplication keys (exactly one is always set)
  // Precedence: cveId > osvId > advisoryId
  cveId       String?  @unique   // "CVE-YYYY-NNNNN"
  osvId       String?  @unique   // OSV ID (GHSA-xxx, PYSEC-xxx, ...), only when there is no CVE
  advisoryId  String?  @unique   // Vendor advisory ID (FG-IR-xx-xxx, ...), only when there is no CVE or OSV ID

  // Best-quality fields (merged with NVD taking precedence over OSV)
  severity    String?            // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  cvssScore   Float?
  cvssVector  String?
  summary     String?
  publishedAt DateTime?
  modifiedAt  DateTime?

  // CISA KEV (Known Exploited Vulnerabilities)
  isKev             Boolean  @default(false)
  kevDateAdded      DateTime?
  kevDueDate        DateTime?
  kevProduct        String?
  kevVendor         String?
  kevShortDesc      String?
  kevRequiredAction String?

  // EPSS (Exploit Prediction Scoring System)
  epssScore      Float?     // 0.0–1.0 probability of exploitation
  epssPercentile Float?     // 0.0–1.0 percentile
  epssUpdatedAt  DateTime?

  // CISA Vulnrichment -- raw SSVC axes only. Deriving a final decision needs a
  // 4th axis (organization-specific Mission & Well-being) CISA does not
  // publish per CVE, so heretix-api does not compute one -- left to heretix-management.
  ssvcExploitation    String?    // "none" | "poc" | "active"
  ssvcAutomatable     String?    // "yes" | "no"
  ssvcTechnicalImpact String?    // "partial" | "total"
  ssvcTimestamp       DateTime?

  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Back-relations to the source tables (the FK lives on the source side)
  osvVulnerabilities     OSVVulnerability[]
  nvdVulnerability       NVDVulnerability?
  advisoryVulnerabilities AdvisoryVulnerability[]
  cnaVulnerability       CnaVulnerability?

  @@index([severity])
  @@index([cvssScore])
  @@index([isKev])
  @@index([epssScore])
  @@index([publishedAt])
}

// ─── OSV ─────────────────────────────────────────────────────

model OSVVulnerability {
  id            String   @id @default(cuid())

  // Identifiers
  osvId         String   @unique
  cveId         String?                   // CVE ID extracted from aliases (for reference)
  aliases       Json?                     // All aliases, as an array
  source        String   @default("osv")
  ecosystem     String?

  // Raw data (JSONB)
  rawData       Json

  // Normalized fields for search
  packageName   String?
  severity      String?
  cvssScore     Float?
  // The distro's own rating of this CVE when it is one value for the whole
  // record -- Ubuntu's priority (extractRecordDistroPriority()). Kept here
  // rather than copied onto each OSVAffectedPackage row: an Ubuntu record has
  // ~45 of them (2.4M rows in total). Per-release ratings (Debian) are on
  // OSVAffectedPackage.distroPriority.
  distroPriority String?
  summary       String?

  // Timestamps
  publishedAt   DateTime?
  modifiedAt    DateTime?
  fetchedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Reference to the master table (FK)
  masterVulnId  String?
  masterVuln    Vulnerability? @relation(fields: [masterVulnId], references: [id])

  // Relations
  affectedPackages OSVAffectedPackage[]

  @@index([osvId])
  @@index([cveId])
  @@index([source, ecosystem])
  @@index([packageName])
  @@index([severity])
  @@index([publishedAt])
  @@index([masterVulnId])
}

model OSVAffectedPackage {
  id              String   @id @default(cuid())

  vulnerabilityId String
  vulnerability   OSVVulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  // Package info
  ecosystem       String
  packageName     String

  // Version range (normalized)
  versionType     String   @default("semver")

  // Range as strings
  introducedVersion   String?
  fixedVersion        String?
  lastAffectedVersion String?

  // Versions as numbers (for fast search)
  introducedInt   BigInt?
  fixedInt        BigInt?
  lastAffectedInt BigInt?

  // The versions field of the OSV rawData (for exact-match search on distro ecosystems)
  affectedVersions String[]

  // The distro's own rating of this CVE for this (release, package), verbatim,
  // when the distro rates per release -- Debian's urgency
  // (extractDistroPriority()). A record-wide rating (Ubuntu) lives on
  // OSVVulnerability.distroPriority instead; search returns this one first.
  // Never merged into the CVE-wide Vulnerability.severity -- see
  // VulnerabilityResult.distroPriority.
  distroPriority String?

  createdAt       DateTime @default(now())

  @@index([ecosystem, packageName])
  @@index([packageName, introducedInt, fixedInt])
  @@index([vulnerabilityId])
  // Covering index for the dashboard's per-ecosystem distinct-vulnerability
  // count (COUNT(DISTINCT "vulnerabilityId") GROUP BY ecosystem). Measured on
  // production-scale data (~3.07M rows): without this, Postgres does a full
  // table scan regardless of planner statistics (ANALYZE alone made no
  // difference) -- 13.7s. With it, an index-only scan over just these two
  // columns -- 5.7s. Still expensive because it's a full index scan (the
  // query has no selective WHERE clause to seek on), which is why this alone
  // isn't the fix; see the response cache in dashboard.ts for the rest.
  @@index([ecosystem, vulnerabilityId])
}

// Debian builds many binary packages from one source package (e.g. source
// "gnupg2" -> binaries "gpgv"/"gpg"/"gpgsm"/...). OSVAffectedPackage.packageName
// for Debian ecosystems is keyed by source name (matching OSV's own
// pkg:deb/debian/<name>?arch=source convention), but installed packages are
// reported by binary name -- this table resolves binary -> source per suite
// so searchOSV() can bridge the two. See debian-sources-fetcher.ts.
model DebianSourcePackage {
  id         String   @id @default(cuid())

  ecosystem  String   // "Debian:12"
  binaryName String
  sourceName String

  updatedAt  DateTime @updatedAt

  @@unique([ecosystem, binaryName])
  @@index([ecosystem, binaryName])
}

// Unresolved entries of the Debian security tracker (debian-tracker-fetcher.ts),
// fully replaced on each run. Used only to attach fixStatus to Debian OSV
// matches -- the tracker carries no-dsa / ignored / postponed, which OSV's
// DEBIAN-CVE records drop. Matching itself stays on OSVAffectedPackage.
// Ubuntu CVE Tracker entries with no fix yet, for the releases heretix-api maintains: why
// an OSV "introduced 0, no fix" row has none (see ubuntuTrackerStatus() in utils/fix-status.ts).
// Fully replaced by the daily ubuntu-tracker job; an entry that has been released is gone.
model UbuntuTrackerStatus {
  id            String   @id @default(cuid())

  ecosystem     String   // "Ubuntu:22.04:LTS", as on OSVAffectedPackage
  sourcePackage String
  vulnId        String   // CVE id
  status        String   // "needs-triage" | "needed" | "pending" | "deferred" | "ignored"
  reason        String?  // the tracker's note in brackets, e.g. "end of standard support"

  @@unique([ecosystem, sourcePackage, vulnId])
  @@index([vulnId])
}

model DebianTrackerStatus {
  id            String   @id @default(cuid())

  ecosystem     String   // "Debian:12"
  sourcePackage String
  vulnId        String   // CVE id, or the tracker's TEMP-... id
  status        String   // "open" | "undetermined"
  urgency       String?
  nodsa         String?  // the no-dsa note, e.g. "Minor issue"
  nodsaReason   String?  // "" | "ignored" | "postponed"

  @@unique([ecosystem, sourcePackage, vulnId])
  @@index([vulnId])
}

// ─── NVD ─────────────────────────────────────────────────────

model NVDVulnerability {
  id          String   @id @default(cuid())

  // Identifiers
  cveId       String   @unique          // "CVE-2024-XXXX"
  source      String   @default("nvd")

  // Raw data (JSONB)
  rawData     Json

  // Normalized fields for search
  severity    String?                   // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  cvssScore   Float?
  cvssVector  String?                   // The full CVSS vector string
  summary     String?

  // Timestamps
  publishedAt DateTime?
  modifiedAt  DateTime?
  fetchedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Reference to the master table (FK, one-to-one)
  masterVulnId  String?  @unique
  masterVuln    Vulnerability? @relation(fields: [masterVulnId], references: [id])

  // Relations
  affectedPackages NVDAffectedPackage[]

  @@index([cveId])
  @@index([severity])
  @@index([publishedAt])
}

model NVDAffectedPackage {
  id              String   @id @default(cuid())

  vulnerabilityId String
  vulnerability   NVDVulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  // Fields derived from the CPE (best effort)
  cpe             String?           // The original CPE string
  vendor          String?           // The <vendor> part of the cpe
  packageName     String            // The <product> part of the cpe
  ecosystem       String?           // Inferred from vendor

  // Version range (NVD format)
  versionStartIncluding String?
  versionStartExcluding String?
  versionEndIncluding   String?
  versionEndExcluding   String?

  // Normalized BigInt (best effort)
  introducedInt   BigInt?
  fixedInt        BigInt?
  lastAffectedInt BigInt?

  // The raw string when the CPE's version field is a specific version rather than
  // "*" or "-" (a true wildcard), but normalizeVersion() cannot turn it into a
  // number (Huawei's V/R/C format, Jenkins build ids, ...). Then introducedInt,
  // fixedInt and lastAffectedInt are all null, so the row looks like a true
  // wildcard and would match unconditionally; this is kept for exact-match search.
  exactVersion    String?

  createdAt       DateTime @default(now())

  @@index([ecosystem, packageName])
  @@index([packageName, introducedInt, fixedInt])
  @@index([vulnerabilityId])
  @@index([vendor, packageName])
  @@index([cpe])
}

// ─── Vendor security advisories ──────────────────────────────

model AdvisoryVulnerability {
  id          String   @id @default(cuid())

  // Identifiers
  source      String                    // "fortinet" | "f5" | "cisco" | "paloalto" | ...
  externalId  String                    // The vendor's own advisory ID (e.g. "FG-IR-24-001")
  cveId       String?                   // The related CVE ID, if any

  // Raw data (JSONB)
  rawData     Json

  // Normalized fields for search
  severity    String?                   // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  cvssScore   Float?
  cvssVector  String?
  summary     String?
  description String?

  // The distro's own rating of this CVE, verbatim -- Red Hat's per-CVE impact
  // ("critical" / "important" / "moderate" / "low"), unlike `severity`, which
  // for an RHSA is the whole advisory's rating. Returned per search result as
  // distroPriority -- see VulnerabilityResult.distroPriority.
  distroPriority String?

  // The part of the product the vendor says the vulnerability is in, verbatim
  // -- MSRC's per-CVE tag ("Role: DNS Server", "Windows Kernel"). Returned
  // per search result as requiresFeatures when it names an optional server
  // role (see config/windows-role-features.ts).
  component String?

  // Advisory-specific fields
  url         String?                   // URL of the original advisory
  workaround  String?                   // Workaround
  solution    String?                   // Solution

  // Timestamps
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // For detecting advisories that have disappeared (only for fetchers that take a
  // full snapshot). The number of runs in a row that did not return this one; reset
  // to 0 when it is found again. It is deleted at the threshold (PRUNE_THRESHOLD,
  // advisory-fetcher.ts).
  missingRunCount Int @default(0)

  // Reference to the master table (FK)
  masterVulnId  String?
  masterVuln    Vulnerability? @relation(fields: [masterVulnId], references: [id])

  // Relations
  affectedProducts AdvisoryAffectedProduct[]

  @@unique([source, externalId])
  @@index([cveId])
  @@index([source])
  @@index([severity])
  @@index([publishedAt])
  @@index([masterVulnId])
}

model AdvisoryAffectedProduct {
  id         String   @id @default(cuid())

  advisoryId String
  advisory   AdvisoryVulnerability @relation(fields: [advisoryId], references: [id], onDelete: Cascade)

  // Product info
  vendor     String                    // "fortinet", "f5", "cisco", ...
  product    String                    // "FortiOS", "BIG-IP", ...

  // Version range (strings)
  versionStart  String?               // First affected version (inclusive)
  versionEnd    String?               // End of the affected range (exclusive)
  versionFixed  String?               // Fixed version
  lastAffected  String?               // End of the affected range (inclusive), for when there is no versionEnd

  // Versions as numbers (only when semver-compatible, for fast search)
  versionStartInt BigInt?
  versionEndInt   BigInt?
  lastAffectedInt BigInt?

  // For non-semver versions: a list of individual versions (e.g. ["7.0.1", "7.0.2", "7.2.0"])
  affectedVersions String[]

  patchAvailable Boolean?

  // Why there is no fix, when the source says (utils/fix-status.ts):
  // affected / deferred / will_not_fix / out_of_support / under_investigation,
  // plus the source's own wording ("Will not fix"). Red Hat VEX only, today.
  fixStatus       String?
  fixStatusDetail String?

  // Red Hat VEX unfixed rows only: the newest fixed build the document records
  // in each minor-release stream (one per "el9_6"-style tag), e.g.
  // ["0:5.14.0-570.140.1.el9_6", "0:5.14.0-427.149.1.el9_4"]. A build tagged
  // with a stream is judged against that stream's fix alone (see
  // matchesRpmVersionRange); versionEnd stays the newest of them, for builds
  // that carry no stream tag.
  streamFixes String[]

  createdAt  DateTime @default(now())

  @@index([vendor, product])
  @@index([product, versionStartInt, versionEndInt])
  @@index([advisoryId])
}

// ─── CVE Record (CNA-declared affected) ──────────────────────
//
// vendor/product/versions as declared by the CNA itself in the CVE Record
// (containers.cna.affected in cvelistV5). Its value is being available without
// waiting for NVD's CPE enrichment: roughly half of the CVEs published in the
// last year have no NVDAffectedPackage row at all, making them undetectable
// through the NVD path.
//
// These live in their own tables rather than alongside NVD/OSV/Advisory data
// because CNA product names are free-form and vary widely in quality; mixing
// them into the existing search paths (searchAdvisory() matches on product name
// alone) would let that noise cause false positives in already-working
// features. Ingest and measure first, then decide how to expose it.
// No search path reads these two tables today -- only validate-cna.ts.
model CnaVulnerability {
  id            String   @id @default(cuid())

  cveId         String   @unique
  cnaShortName  String                    // containers.cna.providerMetadata.shortName (per-CNA quality analysis)

  datePublished DateTime?
  dateUpdated   DateTime?                 // cveMetadata.dateUpdated (change detection for delta imports)

  // Only containers.cna.affected is kept. The rest of the record is already in
  // NVDVulnerability.rawData for nearly every CVE, so storing the whole record
  // here would duplicate hundreds of MB.
  rawAffected   Json

  fetchedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  masterVulnId  String?  @unique
  masterVuln    Vulnerability? @relation(fields: [masterVulnId], references: [id])

  affectedProducts CnaAffectedProduct[]

  @@index([cnaShortName])
  @@index([dateUpdated])
}

model CnaAffectedProduct {
  id              String   @id @default(cuid())

  vulnerabilityId String
  vulnerability   CnaVulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  vendor          String
  product         String
  packageName     String?                 // affected[].packageName, when present
  versionType     String?                 // semver / custom / maven / ... kept verbatim for per-CNA quality analysis

  // Version range (strings). Same upper-bound semantics as AdvisoryAffectedProduct:
  // versionEnd is exclusive (lessThan), lastAffected is inclusive (lessThanOrEqual).
  versionStart    String?
  versionEnd      String?
  lastAffected    String?

  versionStartInt BigInt?
  versionEndInt   BigInt?
  lastAffectedInt BigInt?

  // Only single-version declarations carrying no range operator (lessThan /
  // lessThanOrEqual) land here. Turning one into a range would wrongly widen it
  // to "every version below this one", so it is matched by equality only --
  // the same call apache-fetcher.ts makes for its exact-version advisories.
  affectedVersions String[]

  createdAt       DateTime @default(now())

  @@index([vendor, product])
  @@index([product, versionStartInt, versionEndInt])
  @@index([vulnerabilityId])
}

// ─── Job management ──────────────────────────────────────────

model CollectionJob {
  id          String   @id @default(cuid())
  source      String
  status      String   @default("pending")
  priority    Int      @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  totalFetched    Int    @default(0)
  totalInserted   Int    @default(0)
  totalUpdated    Int    @default(0)
  totalFailed     Int    @default(0)

  errorMessage    String?
  errorStack      String?
  metadata        Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, status])
  @@index([status, priority, createdAt])
  @@index([completedAt])
}

// Enabled/disabled flag of a collection job (enabled by default when there is no row)
model JobConfig {
  source    String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Ledger of the migrate-*.ts scripts migrate-all.js has already run. A script
// recorded here is skipped on every later container start.
model DataMigration {
  name      String   @id
  appliedAt DateTime @default(now())
}
