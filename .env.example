# Database
DATABASE_URL="postgresql://user:password@localhost:5432/heretix"

# Integration test database (pnpm test:integration). Must point at a disposable
# database — its tables are truncated before every test. Never point this at
# the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/heretix_test"

# API Server
PORT=5000

# Optional. Set to "production" for a production deployment -- raises the
# pino log level from debug to info. Defaults to development behavior when unset.
NODE_ENV=development

# API Key authentication (required — requests without a matching x-api-key header are rejected with 401).
# The key heretix-management, heretix-cli and scripts search with. Generate one with: openssl rand -hex 32
API_KEY=your-api-key-here

# Admin key: running and switching jobs, and the import dashboard's data. A key of its
# own, so the shared API_KEY cannot start scrapers or stop the imports. Unset, those
# endpoints answer 401. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=your-admin-key-here

# Trusted reverse proxy (optional, default: none). Set it to the address of a TLS
# proxy in front of this API (comma-separated, CIDR allowed), so the per-address
# rate limits see the real client in X-Forwarded-For. Unset, that header is ignored.
# TRUST_PROXY=10.0.0.5
# Also set BIND_ADDRESS=127.0.0.1 so only the proxy reaches the API (docs/tls-proxy.md).
# BIND_ADDRESS=127.0.0.1

# CORS: comma-separated browser origins allowed to read cross-origin responses
# (optional, default: none). Only matters for a browser-based client calling
# this API from a different origin -- server-to-server callers (e.g.
# heretix-management, which calls this API server-side) never enforce CORS
# and are unaffected either way.
# ALLOWED_ORIGINS=https://dashboard.example.com,https://other.example.com

# Postgres connection pool size (optional, default 20). A single search issues
# up to 4 queries in parallel and the batch endpoint runs several at a time, so
# raise this alongside a larger Postgres if the pool becomes the bottleneck.
DATABASE_POOL_MAX=20

# NVD (National Vulnerability Database) API Key
# Get your key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Cisco API credentials (for Cisco advisory import)
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
